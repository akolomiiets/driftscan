<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'sha256-{{.ScriptHash}}'; base-uri 'none'">
<meta name="color-scheme" content="light dark">
<title>driftscan report</title>
<style>
:root{--bg:#fff;--fg:#1f2328;--muted:#656d76;--line:#d0d7de;--card:#f6f8fa;--link:#0969da;--ok:#1a7f37;--warn:#9a6700;--bad:#cf222e;--okbg:#dafbe1;--warnbg:#fff8c5;--badbg:#ffebe9}
@media (prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--muted:#8d96a0;--line:#30363d;--card:#161b22;--link:#4493f8;--ok:#3fb950;--warn:#d29922;--bad:#f85149;--okbg:#12261e;--warnbg:#272115;--badbg:#2d1214}}
*{box-sizing:border-box}
body{margin:0;padding:1.5rem;background:var(--bg);color:var(--fg);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
a{color:var(--link)}
[hidden]{display:none!important}
h1{margin:0 0 .5rem;font-size:1.5rem}
h2{margin:1.5rem 0 .5rem;font-size:1.1rem}
.banner{display:inline-block;padding:.15rem .6rem;border-radius:1rem;font-weight:600;border:1px solid currentColor}
.banner.ok{color:var(--ok);background:var(--okbg)}.banner.warn{color:var(--warn);background:var(--warnbg)}.banner.bad{color:var(--bad);background:var(--badbg)}
.meta{color:var(--muted);margin:.5rem 0}
.note{margin:.5rem 0;padding:.4rem .75rem;border-left:4px solid var(--warn);background:var(--warnbg)}
.counters{display:flex;flex-wrap:wrap;gap:.5rem;margin:.75rem 0;padding:0;list-style:none}
.counters li{padding:.3rem .75rem;border:1px solid var(--line);border-radius:.4rem;background:var(--card)}
.counters b{font-size:1.1rem}
form#filters{display:flex;flex-wrap:wrap;gap:.75rem;align-items:end;margin:1rem 0;padding:.75rem;border:1px solid var(--line);border-radius:.4rem;background:var(--card)}
form#filters label{display:flex;flex-direction:column;font-size:.8rem;color:var(--muted)}
select,input{font:inherit;color:var(--fg);background:var(--bg);border:1px solid var(--line);border-radius:.3rem;padding:.25rem .4rem}
#shown{margin:0 0 .5rem;color:var(--muted)}
details.root{margin:.4rem 0;border:1px solid var(--line);border-radius:.4rem}
details.root>summary{padding:.4rem .75rem;cursor:pointer;background:var(--card);border-radius:.4rem}
details.root[open]>summary{border-bottom:1px solid var(--line);border-radius:.4rem .4rem 0 0}
summary .path{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:600}
summary .small{color:var(--muted);font-size:.85rem;margin-left:.5rem}
.table-wrap{overflow-x:auto;padding:0 .5rem .5rem}
table{border-collapse:collapse;width:100%;margin-top:.5rem}
th,td{text-align:left;vertical-align:top;padding:.3rem .5rem;border-bottom:1px solid var(--line)}
th{font-size:.8rem;color:var(--muted);white-space:nowrap}
code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.85rem;overflow-wrap:anywhere}
tr.resolved td{color:var(--muted);opacity:.75}
tr.resolved code{text-decoration:line-through}
.sev{font-weight:600}.sev-critical,.sev-high{color:var(--bad)}.sev-medium{color:var(--warn)}.sev-low,.sev-info{color:var(--muted)}
.msg{white-space:pre-wrap;overflow-wrap:anywhere}
.detail{display:block;color:var(--muted);font-size:.85rem}
details.acks{margin:.5rem .5rem 0}
details.acks>summary{cursor:pointer;color:var(--muted)}
footer{margin-top:2rem;color:var(--muted);font-size:.8rem}
</style>
</head>
<body>
<header>
<h1>driftscan report</h1>
<p><span class="banner {{.StatusClass}}">{{.StatusText}}</span></p>
<p class="meta">driftscan {{.Tool}} | started {{.Started}} | duration {{.Duration}} | {{.Counts.Roots}} Roots scanned, {{.Counts.RootsDrifted}} with Drift</p>
{{if not .Compared}}<p class="note">No Baseline: this Scan establishes it. Statuses start from the next Scan.</p>{{end}}
{{if .Partial}}<p class="note">Partial report: some Roots were not scanned{{if .Shard}} (shard {{.Shard}}){{end}}, so Findings of absent Roots are unknown, not resolved.</p>{{end}}
<ul class="counters" aria-label="Counters">
<li><b>{{.Counts.Drift}}</b> Drift</li>
<li><b>{{.Counts.Pending}}</b> Pending changes</li>
<li><b>{{.Counts.Errors}}</b> Scan errors</li>
<li><b>{{.Counts.Acknowledged}}</b> acknowledged</li>
<li><b>{{.Counts.Resolved}}</b> resolved</li>
{{if .Compared}}<li><b>{{.Added}}</b> new</li>
<li><b>{{.Changed}}</b> changed</li>{{end}}
</ul>
</header>
<main>
<form id="filters" hidden>
<label>Environment<select id="f-env"><option value="">All</option>{{range .Envs}}<option value="{{.}}">{{.}}</option>{{end}}</select></label>
<label>Kind<select id="f-kind"><option value="">All</option><option value="drift">Drift</option><option value="pending">Pending</option><option value="scan_error">Scan error</option></select></label>
<label>Minimum severity<select id="f-sev"><option value="0">info</option><option value="1">low</option><option value="2">medium</option><option value="3">high</option><option value="4">critical</option></select></label>
<label>Status<select id="f-status"><option value="">All</option><option value="new">new</option><option value="changed">changed</option><option value="persisting">persisting</option><option value="resolved">resolved</option><option value="unknown">unknown</option><option value="none">none</option></select></label>
<label>Search<input id="f-q" type="search" placeholder="Root, resource or attribute" autocomplete="off"></label>
</form>
<p id="shown" role="status" aria-live="polite">{{.Total}} Findings</p>
{{range .Groups}}<section class="env" aria-label="{{if .Name}}{{.Name}}{{else}}top level{{end}}">
<h2>{{if .Name}}{{.Name}}{{else}}(top level){{end}}</h2>
{{range .Roots}}<details class="root"{{if .Open}} open{{end}}>
<summary><span class="path">{{.Path}}</span><span class="small">{{.Summary}}</span></summary>
{{if .Rows}}<div class="table-wrap">{{template "table" .Rows}}</div>{{end}}
{{if .AckRows}}<details class="acks"><summary>Acknowledged ({{len .AckRows}})</summary><div class="table-wrap">{{template "table" .AckRows}}</div></details>{{end}}
</details>
{{end}}</section>
{{end}}</main>
<footer>Generated {{.Generated}} by driftscan. Attribute values are never included in a report.</footer>
<script>{{.Script}}</script>
</body>
</html>
{{define "table"}}<table>
<thead><tr><th scope="col">Kind</th><th scope="col">Severity</th><th scope="col">Status</th><th scope="col">Resource</th><th scope="col">Attributes</th><th scope="col">Location</th><th scope="col">Details</th></tr></thead>
<tbody>
{{range .}}<tr{{if .Resolved}} class="resolved"{{end}} data-env="{{.Env}}" data-kind="{{.Kind}}" data-sev="{{.SevRank}}" data-status="{{.StatusKey}}" data-q="{{.Search}}">
<td>{{.KindText}}</td>
<td class="sev sev-{{.Severity}}">{{.Severity}}</td>
<td>{{.StatusText}}</td>
<td>{{if .Address}}<code>{{.Address}}</code>{{else}}-{{end}}</td>
<td>{{if .Paths}}<code>{{.Paths}}</code>{{else}}{{.Actions}}{{end}}</td>
<td>{{if .LocURL}}<a href="{{.LocURL}}" target="_blank" rel="noopener noreferrer">{{.Loc}}</a>{{else if .Loc}}<code>{{.Loc}}</code>{{else}}-{{end}}</td>
<td>{{if .Message}}<span class="msg">{{.Message}}</span>{{end}}{{if .AckText}}<span class="detail">{{.AckText}}</span>{{end}}{{if .Owner}}<span class="detail">owner: {{.Owner}}</span>{{end}}{{if .ChangedBy}}<span class="detail">changed by: {{.ChangedBy}}</span>{{end}}</td>
</tr>
{{end}}</tbody>
</table>{{end}}
